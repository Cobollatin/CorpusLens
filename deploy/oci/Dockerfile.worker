FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG TARGETARCH
WORKDIR /src
COPY CorpusLens.sln ./
COPY src/CorpusLens.Core/*.csproj src/CorpusLens.Core/
COPY src/CorpusLens.Infrastructure/*.csproj src/CorpusLens.Infrastructure/
COPY src/CorpusLens.Worker/*.csproj src/CorpusLens.Worker/
RUN dotnet restore src/CorpusLens.Worker/CorpusLens.Worker.csproj -a $TARGETARCH
COPY src/ src/
RUN dotnet publish src/CorpusLens.Worker/CorpusLens.Worker.csproj -c Release -a $TARGETARCH --no-restore -o /app/publish
FROM mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app
COPY --from=build /app/publish .
USER $APP_UID
ENTRYPOINT ["dotnet", "CorpusLens.Worker.dll"]
